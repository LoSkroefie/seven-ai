# Copy to /etc/seven/seven-web.env, replace every CHANGE_ME value, chmod 0600.
SEVEN_WEB_BIND=127.0.0.1
SEVEN_WEB_PORT=18788
SEVEN_PUBLIC_ORIGIN=https://jvrsoftware.co.za
SEVEN_INTERNAL_URL=http://127.0.0.1:18765
SEVEN_UPSTREAM_TIMEOUT=960
SEVEN_INTERNAL_TOKEN=CHANGE_ME_MUST_EXACTLY_MATCH_SEVEN_CORE_API_TOKEN
SEVEN_OWNER_PASSWORD_HASH=CHANGE_ME_RUN_python_-m_seven_gateway.hash_password
SEVEN_SESSION_SECRET=CHANGE_ME_DIFFERENT_RANDOM_48_PLUS_CHARACTERS
SEVEN_WEB_DB=/var/lib/seven-web/gateway.sqlite3
SEVEN_WEB_STATIC=/opt/seven/deploy/peanut/static
SEVEN_WEB_LOG_LEVEL=INFO
SEVEN_SESSION_TTL=43200
SEVEN_SESSION_IDLE=3600
SEVEN_QUEUE_LIMIT=32
SEVEN_RATE_PER_MINUTE=120
SEVEN_LOGIN_RATE_PER_10_MINUTES=10
SEVEN_MEDIA_RATE_PER_MINUTE=12
SEVEN_TRANSCRIPTION_ENABLED=1
SEVEN_WHISPER_MODEL=tiny.en
SEVEN_WHISPER_DOWNLOAD_ROOT=/var/lib/seven-web/models
SEVEN_WHISPER_THREADS=2
