# Dedicated loopback-only Ollama runtime for Seven. It shares immutable model
# blobs with the main Ollama installation but has its own queue and runner.
OLLAMA_HOST=127.0.0.1:11435
OLLAMA_MODELS=/usr/share/ollama/.ollama/models
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_NUM_PARALLEL=1
OLLAMA_KEEP_ALIVE=5m
OLLAMA_MAX_QUEUE=16
