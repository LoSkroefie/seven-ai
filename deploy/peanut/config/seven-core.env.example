# Copy to /etc/seven/seven-core.env, replace every CHANGE_ME value, chmod 0600.
SEVEN_API_HOST=127.0.0.1
SEVEN_API_PORT=8765
SEVEN_API_TOKEN=CHANGE_ME_INDEPENDENT_RANDOM_48_PLUS_CHARACTERS
SEVEN_DATA_DIR=/var/lib/seven
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:latest
OLLAMA_VISION_MODEL=qwen3-vl:2b
SEVEN_API_MAX_BODY_BYTES=8000000
SEVEN_LLM_PROVIDER=ollama
SEVEN_LOG_LEVEL=INFO
